# Database (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@direct-host/dbname?sslmode=require

# Gemini LLM
GEMINI_API_KEYS=key1,key2,key3
GEMINI_FILTER_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACT_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_RPM_PER_KEY=15

# Source API keys (pipeline only)
APIFY_TOKEN=your_apify_token
SERPAPI_KEY=your_serpapi_key
YOUTUBE_API_KEY=your_youtube_api_key

# Backend
BACKEND_API_KEY=your_backend_api_key
ALLOWED_ORIGIN=https://your-app.vercel.app

# Frontend
APP_PASSWORD=your_app_password
BACKEND_URL=http://localhost:8000
